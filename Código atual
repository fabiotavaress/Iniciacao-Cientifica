import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pycirclize import Circos

# --- Utils ---
def pretty_breaks(vmin: float, vmax: float, n: int = 5):
    """Generate ~n aesthetically pleasing breaks similar to R's pretty()."""
    if not np.isfinite(vmin) or not np.isfinite(vmax):
        return np.linspace(0.0, 1.0, n)
    if vmin == vmax:
        if vmin == 0:
            vmin, vmax = -1, 1
        else:
            vmin *= 0.9
            vmax *= 1.1
    if vmin > vmax:
        vmin, vmax = vmax, vmin
    raw = (vmax - vmin) / max(n - 1, 1)
    if raw == 0:
        raw = abs(vmax) if vmax != 0 else 1.0
    mag = 10 ** np.floor(np.log10(raw))
    nice_steps = np.array([1, 2, 2.5, 5, 10]) * mag
    step = nice_steps[np.searchsorted(nice_steps, raw, side="left")]
    # If raw larger than last nice_steps, bump one decade
    if step < raw:
        step *= 10
    start = np.floor(vmin / step) * step
    end = np.ceil(vmax / step) * step
    ticks = np.arange(start, end + 0.5 * step, step)
    # If too many ticks, downsample to n keeping ends
    if len(ticks) > n:
        # choose indices to get exactly n entries
        idx = np.linspace(0, len(ticks) - 1, n).round().astype(int)
        ticks = ticks[idx]
    elif len(ticks) < n:
        # fall back to linspace if necessary
        ticks = np.linspace(vmin, vmax, n)
    return ticks

# --- Carregar e processar dados (comum a ambos os gráficos) ---
data = pd.read_csv("wfg4_dwu-dec.csv", header=None)
points = data.values
num_points, num_dims = points.shape

# --- Parte 1: Lógica do Diagrama de Pontos (cálculo da norma e ângulos) ---
result_matrix = np.zeros((num_points, num_dims + 1))
for i in range(num_points):
    point = points[i]
    norm = np.linalg.norm(point)
    result_matrix[i, 0] = norm
    if norm != 0:
        result_matrix[i, 1:] = np.arccos(point / norm)
    else:
        result_matrix[i, 1:] = np.nan

angles = result_matrix[:, 1:]
min_angle_indices = np.nanargmin(angles, axis=1)
min_angles = angles[np.arange(num_points), min_angle_indices]
norms = result_matrix[:, 0]
classification = np.column_stack((min_angle_indices, min_angles, norms))

# --- Configuração do Circos ---
# 1. Calcular max_angle
max_angle = np.arccos(1 / np.sqrt(num_dims))

sector_names = [f"{i+1}" for i in range(num_dims)]
# 2. Definir cada setor com "largura" igual a esse max_angle
sectors = {name: max_angle for name in sector_names}
# Define spacing: large gap (30) between sector 9 and sector 1, smaller gap (5) elsewhere
spaces = [5] * (num_dims - 1) + [30]
circos = Circos(sectors=sectors, space=spaces)

# --- Parte 2: Plotagem do Diagrama de Pontos (exterior) ---
min_angle_val = np.nanmin(min_angles)
max_angle_val = np.nanmax(min_angles)
min_norm_val = np.nanmin(norms)
max_norm_val = np.nanmax(norms)

for i, sector in enumerate(circos.sectors):
    sector.text(sector.name, r=110, size=12)
    scatter_track = sector.add_track((70, 100), r_pad_ratio=0.1)
    scatter_track.axis()
    
    # 4. Nos ticks horizontais, escolha um intervalo uniforme de cerca de cinco divisões entre 0 e max_angle
    horizontal_tick_interval = max_angle / 5
    scatter_track.xticks_by_interval(
        interval=horizontal_tick_interval,
        label_size=6,
        line_kws=dict(color="black"),
        label_formatter=lambda v: f"{v:.2f}"
    )

    # Ticks verticais somente no setor 1, lado esquerdo, com ~5 "pretty" breaks em unidades de rho
    if sector.name == '1':
        y_ticks = pretty_breaks(float(min_norm_val), float(max_norm_val), n=5)
        scatter_track.yticks(
            y=y_ticks,
            labels=[f"{v:.1f}" for v in y_ticks],
            vmin=float(min_norm_val),
            vmax=float(max_norm_val),
            label_size=6,
            line_kws=dict(color="black"),
            side="left"
        )

    idx = np.where(classification[:, 0] == i)[0]
    if len(idx) > 0:
        x = classification[idx, 1]
        y = classification[idx, 2]
        # 3. Para posicionar os pontos no eixo X, use diretamente o ângulo bruto (já em radianos) e assegure-se de mantê-lo entre 0 e max_angle
        x_scaled = np.clip(x, 0, max_angle - 1e-9) # Use o ângulo bruto e clipe para max_angle
        
        # y: mapeado linearmente para a altura do trilho, coerente com vmin/vmax acima
        track_height = 100 - 70
        y_scaled = ((y - min_norm_val) / (max_norm_val - min_norm_val)) * track_height
        # jitter leve para evitar sobreposição
        jitter_strength = 0.02 * max_angle # Ajustar jitter para max_angle
        x_jitter = np.random.uniform(-jitter_strength, jitter_strength, size=len(x_scaled))
        y_jitter = np.random.uniform(-1.0, 1.0, size=len(y_scaled))
        x_scaled = np.clip(x_scaled + x_jitter, 0, max_angle - 1e-9) # Clipe para max_angle
        y_scaled = np.clip(y_scaled + y_jitter, 0, track_height)
        scatter_track.scatter(x_scaled, y_scaled, s=8, color="blue", marker="o", alpha=0.5)

# --- Parte 3: Lógica do Diagrama de Cordas (interior) ---
for sector in circos.sectors:
    chord_track = sector.add_track((50, 65))
    # 5. Ticks horizontais para o diagrama de cordas também
    chord_track.xticks_by_interval(
        interval=horizontal_tick_interval,
        label_size=6,
        line_kws=dict(color="black"),
        label_formatter=lambda v: f"{v:.2f}"
    )

# Criar as conexões (cordas)
for k in range(num_points):
    for i in range(num_dims):
        aux = (i + 1) % num_dims
        # Mapear os valores de data.iloc[k, i] para o intervalo [0, max_angle]
        # Assumindo que os valores de data.iloc[k, i] são positivos e precisam ser escalados
        # para o novo range do setor (0 a max_angle)
        scaled_data_i = (data.iloc[k, i] - data.min().min()) / (data.max().max() - data.min().min()) * max_angle
        scaled_data_aux = (data.iloc[k, aux] - data.min().min()) / (data.max().max() - data.min().min()) * max_angle
        circos.link_line((str(i+1), scaled_data_i), (str(aux+1), scaled_data_aux), r1=50, r2=65, lw=.3, color='red')

# --- Finalização ---
fig = circos.plotfig()
plt.savefig("combined_plot_no_chord_sectors.png", dpi=200, bbox_inches="tight")
